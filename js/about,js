/* ============================================================
   19. 3D CARD TILT
============================================================ */

function initialiseCardTilt() {

    if (isMobile) return;


    const cards =
        document.querySelectorAll(
            ".challenge-card, .value-card"
        );


    cards.forEach((card) => {

        card.addEventListener(
            "mousemove",
            (event) => {

                const rect =
                    card.getBoundingClientRect();


                const x =
                    event.clientX -
                    rect.left;

                const y =
                    event.clientY -
                    rect.top;


                const centerX =
                    rect.width / 2;

                const centerY =
                    rect.height / 2;


                const rotateY =
                    ((x - centerX) /
                        centerX) * 3.5;


                const rotateX =
                    ((centerY - y) /
                        centerY) * 3.5;


                animate(
                    card,
                    {
                        rotateX,
                        rotateY,
                        scale: 1.015
                    },
                    {
                        duration: 0.18
                    }
                );

            }
        );


        card.addEventListener(
            "mouseleave",
            () => {

                animate(
                    card,
                    {
                        rotateX: 0,
                        rotateY: 0,
                        scale: 1
                    },
                    {
                        type: spring,
                        stiffness: 240,
                        damping: 20
                    }
                );

            }
        );

    });

}


/* ============================================================
   20. MAGNETIC BUTTON EFFECT
============================================================ */

function initialiseMagneticButtons() {

    if (isMobile) return;


    const buttons =
        document.querySelectorAll(
            ".button"
        );


    buttons.forEach((button) => {

        button.addEventListener(
            "mousemove",
            (event) => {

                const rect =
                    button.getBoundingClientRect();


                const x =
                    event.clientX -
                    rect.left -
                    rect.width / 2;


                const y =
                    event.clientY -
                    rect.top -
                    rect.height / 2;


                animate(
                    button,
                    {
                        x: x * 0.12,
                        y: y * 0.18,
                        scale: 1.025
                    },
                    {
                        duration: 0.2
                    }
                );

            }
        );


        button.addEventListener(
            "mouseleave",
            () => {

                animate(
                    button,
                    {
                        x: 0,
                        y: 0,
                        scale: 1
                    },
                    {
                        type: spring,
                        stiffness: 300,
                        damping: 18
                    }
                );

            }
        );

    });

}


/* ============================================================
   21. CAPABILITY HOVER
============================================================ */

function initialiseCapabilityHover() {

    const capabilityItems =
        document.querySelectorAll(
            ".capability-item"
        );


    capabilityItems.forEach((item) => {

        const arrow =
            item.querySelector("small");

        const title =
            item.querySelector("strong");


        item.addEventListener(
            "mouseenter",
            () => {

                if (arrow) {

                    animate(
                        arrow,
                        {
                            x: 9,
                            scale: 1.15
                        },
                        {
                            type: spring,
                            stiffness: 300,
                            damping: 18
                        }
                    );

                }


                if (title) {

                    animate(
                        title,
                        {
                            x: 4
                        },
                        {
                            duration: 0.2
                        }
                    );

                }

            }
        );


        item.addEventListener(
            "mouseleave",
            () => {

                if (arrow) {

                    animate(
                        arrow,
                        {
                            x: 0,
                            scale: 1
                        },
                        {
                            type: spring,
                            stiffness: 300,
                            damping: 18
                        }
                    );

                }


                if (title) {

                    animate(
                        title,
                        {
                            x: 0
                        },
                        {
                            duration: 0.2
                        }
                    );

                }

            }
        );

    });

}


/* ============================================================
   22. MOBILE NAVIGATION
============================================================ */

function initialiseNavigation() {

    const menuButton =
        document.getElementById(
            "mobileMenuButton"
        );

    const navigation =
        document.getElementById(
            "mainNavigation"
        );


    if (
        !menuButton ||
        !navigation
    ) {
        return;
    }


    menuButton.addEventListener(
        "click",
        () => {

            navigation.classList.toggle(
                "nav-open"
            );


            const isOpen =
                navigation.classList.contains(
                    "nav-open"
                );


            menuButton.setAttribute(
                "aria-expanded",
                String(isOpen)
            );


            if (
                isOpen &&
                !reduceMotion
            ) {

                animate(
                    navigation,
                    {
                        opacity: [0, 1],
                        y: [-14, 0]
                    },
                    {
                        duration: 0.3,
                        easing:
                            transitions.reveal.easing
                    }
                );


                animate(
                    ".main-nav .nav-links li",
                    {
                        opacity: [0, 1],
                        x: [-15, 0]
                    },
                    {
                        duration: 0.35,

                        delay: stagger(
                            0.045
                        )
                    }
                );

            }

        }
    );

}


