/* ============================================================
   24. REDUCED MOTION FALLBACK
============================================================ */

function revealEverything() {

    const animatedElements =
        document.querySelectorAll(`
            .about-hero-content,
            .about-hero-message,
            .who-heading,
            .who-content,
            .challenge-card,
            .belief-content,
            .belief-item,
            .vision-card,
            .mission-card,
            .value-card,
            .about-approach-heading,
            .process-item,
            .capability-heading,
            .capability-item,
            .journey-heading,
            .journey-content,
            .about-cta-content
        `);


    animatedElements.forEach(
        (element) => {

            element.style.opacity = "1";
            element.style.transform = "none";

        }
    );

}