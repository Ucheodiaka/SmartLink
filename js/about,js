/* ============================================================
   5. HERO SPLIT-TEXT ANIMATION
============================================================ */

function initialiseHeroText() {

    const heroHeading =
        document.querySelector(".about-hero-content h1");

    if (!heroHeading) return;


    /*
        Preserve accessibility.
    */

    const originalText =
        heroHeading.textContent.trim();

    heroHeading.setAttribute(
        "aria-label",
        originalText
    );


    /*
        Convert text nodes into animated words while
        keeping elements like <span> intact.
    */

    splitHeroIntoWords(heroHeading);


    const words =
        heroHeading.querySelectorAll(".motion-word");


    animate(
        ".about-hero .section-eyebrow",
        {
            opacity: [0, 1],
            y: [20, 0]
        },
        {
            duration: 0.5,
            easing: "ease-out"
        }
    );


    animate(
        words,
        {
            opacity: [0, 1],
            y: ["110%", "0%"],
            rotateX: [35, 0]
        },
        {
            duration: 0.8,

            delay: stagger(
                0.055,
                {
                    startDelay: 0.1
                }
            ),

            easing: [0.16, 1, 0.3, 1]
        }
    );


    animate(
        ".about-hero-content > p",
        {
            opacity: [0, 1],
            y: [30, 0]
        },
        {
            duration: 0.75,
            delay: 0.55,
            easing: transitions.reveal.easing
        }
    );


    animate(
        ".about-hero-message",
        {
            opacity: [0, 1],
            x: [60, 0],
            rotateY: [-8, 0],
            scale: [0.94, 1]
        },
        {
            duration: 1,
            delay: 0.4,
            easing: transitions.reveal.easing
        }
    );

}


function splitHeroIntoWords(element) {

    const processNode = (node) => {

        if (node.nodeType === Node.TEXT_NODE) {

            const fragment =
                document.createDocumentFragment();

            const words =
                node.textContent.split(/(\s+)/);


            words.forEach((word) => {

                if (word.trim() === "") {

                    fragment.appendChild(
                        document.createTextNode(word)
                    );

                    return;
                }


                const wrapper =
                    document.createElement("span");

                wrapper.className =
                    "motion-word-wrapper";


                const wordElement =
                    document.createElement("span");

                wordElement.className =
                    "motion-word";

                wordElement.textContent =
                    word;


                wrapper.appendChild(
                    wordElement
                );

                fragment.appendChild(
                    wrapper
                );

            });


            node.replaceWith(fragment);

        }

        else if (
            node.nodeType === Node.ELEMENT_NODE
        ) {

            [...node.childNodes].forEach(
                processNode
            );

        }

    };


    [...element.childNodes].forEach(
        processNode
    );

}


/* ============================================================
   6. HERO SCROLL PARALLAX
============================================================ */

function initialiseHeroParallax() {

    const hero =
        document.querySelector(".about-hero");

    const content =
        document.querySelector(".about-hero-content");

    const purposeCard =
        document.querySelector(".about-hero-message");


    if (!hero) return;


    if (content) {

        scroll(

            animate(
                content,
                {
                    y: [0, 75],
                    opacity: [1, 0.45]
                }
            ),

            {
                target: hero,
                offset: [
                    "start start",
                    "end start"
                ]
            }

        );

    }


    if (
        purposeCard &&
        !isMobile
    ) {

        scroll(

            animate(
                purposeCard,
                {
                    y: [0, -55],
                    rotate: [0, 1.5]
                }
            ),

            {
                target: hero,
                offset: [
                    "start start",
                    "end start"
                ]
            }

        );

    }

}


