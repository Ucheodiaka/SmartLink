import {
    animate,
    inView,
    scroll,
    stagger,
    spring
} from "https://cdn.jsdelivr.net/npm/motion@latest/+esm";


/* ============================================================
   1. GLOBAL SETTINGS
============================================================ */

const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
).matches;

const isMobile = window.matchMedia(
    "(max-width: 768px)"
).matches;


/* ============================================================
   2. MOTION PRESETS
============================================================ */

const transitions = {

    reveal: {
        duration: 0.85,
        easing: [0.22, 1, 0.36, 1]
    },

    soft: {
        duration: 0.65,
        easing: [0.25, 1, 0.5, 1]
    },

    spring: {
        type: spring,
        stiffness: 220,
        damping: 22
    }

};


/* ============================================================
   3. PAGE INITIALISATION
============================================================ */

document.addEventListener("DOMContentLoaded", () => {

    initialiseNavigation();
    initialiseCurrentYear();

    if (reduceMotion) {
        revealEverything();
        return;
    }

    initialisePageIntro();
    initialiseHeroText();
    initialiseHeroParallax();
    initialiseScrollProgress();

    initialiseWhoSection();
    initialiseChallenges();
    initialiseBeliefSection();
    initialiseVisionMission();
    initialiseValues();
    initialiseApproach();
    initialiseCapabilities();
    initialiseJourney();
    initialiseFinalCTA();

    initialiseMagneticButtons();
    initialiseCardTilt();
    initialiseCapabilityHover();
    initialiseSectionEyebrows();
    initialiseSectionParallax();

});


